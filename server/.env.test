# ===========================
# VARIABLES D'ENVIRONNEMENT POUR LES TESTS JEST
# SQLite en mémoire — ne touche JAMAIS à la base Neon
# ===========================

NODE_ENV=test

# Laisser DATABASE_URL vide → database.js utilisera SQLite automatiquement
DATABASE_URL=

# JWT secret fixe pour les tests
JWT_SECRET=test_jwt_secret_super_secure_12345

# Frontend URL (pour les redirections OAuth)
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Cloudinary (désactivé en tests)
CLOUDINARY_CLOUD_NAME=test
CLOUDINARY_API_KEY=test
CLOUDINARY_API_SECRET=test

# SMTP (désactivé en tests)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Google OAuth (désactivé en tests)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Skip DB sync pendant les tests (on fait sync manuellement dans setup)
SKIP_DB_SYNC=true
